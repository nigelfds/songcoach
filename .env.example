# Copy to .env and fill in. Values here are dev-friendly defaults.

# --- App ---
SECRET_KEY=change-me-in-prod
DEBUG=true

# --- Database ---
# Local dev uses SQLite; Heroku injects DATABASE_URL (postgres://...)
DATABASE_URL=sqlite:///./songcoach.db

# --- Background jobs ---
# If REDIS_URL is set, jobs run on the RQ worker. Otherwise, or if
# RUN_JOBS_INLINE=true, they run in a background thread in the web process.
REDIS_URL=redis://localhost:6379/0
RUN_JOBS_INLINE=false

# --- Storage: "local" or "s3" ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data
# S3 (STORAGE_BACKEND=s3)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_SIGNED_URL_TTL=3600

# --- YouTube / yt-dlp cookies (Premium / ad-free). Pick ONE. ---
# A) Read straight from a local browser: chrome | safari | firefox | edge | brave
YTDLP_COOKIES_FROM_BROWSER=
# B) Path to an exported Netscape cookies.txt
YTDLP_COOKIES_FILE=
# C) Raw cookies.txt contents (for Heroku config var; worker writes a temp file)
YTDLP_COOKIES=

# --- Demucs ---
# htdemucs (best) or mdx_extra_q (lighter/faster, less RAM)
DEMUCS_MODEL=htdemucs
# Output format for web playback
STEM_FORMAT=mp3
MAX_DURATION_SECONDS=600
