{
  "name": "SongCoach",
  "description": "Drum practice tool: YouTube → AI stem separation → looping player.",
  "stack": "heroku-24",
  "buildpacks": [
    { "url": "https://github.com/heroku/heroku-buildpack-apt" },
    { "url": "heroku/python" }
  ],
  "addons": [
    "heroku-postgresql:essential-0",
    "heroku-redis:mini"
  ],
  "env": {
    "SECRET_KEY": { "generator": "secret" },
    "STORAGE_BACKEND": { "value": "s3" },
    "S3_BUCKET": { "required": true },
    "AWS_ACCESS_KEY_ID": { "required": true },
    "AWS_SECRET_ACCESS_KEY": { "required": true },
    "AWS_REGION": { "value": "us-east-1" },
    "DEMUCS_MODEL": { "value": "htdemucs" },
    "YTDLP_COOKIES": { "required": false }
  },
  "formation": {
    "web": { "quantity": 1, "size": "standard-1x" },
    "worker": { "quantity": 1, "size": "standard-2x" }
  }
}
